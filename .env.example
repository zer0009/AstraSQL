OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
LLM_PROVIDER=openai
# Required when DEBUG=false. Generate a long random string, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ENCRYPTION_KEY=
SQLITE_URL=sqlite+aiosqlite:///./data/astrasql.db
# Optional alias of SQLITE_URL (use later to point metadata at Postgres)
# DATABASE_URL=
DATA_DIR=./data
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
MAX_RESULT_ROWS=500
MAX_CONVERSATION_TURNS=3
# Schema-grounded clarification (ask vs proceed after retrieving schema)
GROUNDED_CLARIFICATION_ENABLED=true
# Optional cheaper model for the interpretation resolver (empty → ENRICHMENT_MODEL)
# INTERPRETATION_MODEL=gpt-4o-mini
# Reasoning models (gpt-5.*): none|low|medium|high
# LLM_REASONING_EFFORT=low
# Ablation / performance switches
# INTERPRETATION_MODE=on
# VALIDATOR_MODE=full
# SCHEMA_LINK_MODE=auto
# FORMAT_RESPONSE=true
# SQL_CANDIDATE_COUNT=1
# QUERY_TIMEOUT_SECONDS=30
# INTENT_MODEL=
# FORMATTER_MODEL=
# EXPANSION_MODEL=
# Execution-evidence ambiguity gate
# EXECUTION_EVIDENCE_GATE=true
# MERGE_INTERPRET_GENERATE=true
# (default true: skips intent+resolver; generator returns not_a_data_question when needed)
# AMBIGUITY_SAMPLE_COUNT=3
# AMBIGUITY_DOMINANCE_THRESHOLD=0.67
# AMBIGUITY_POLICY=balanced
# EXPLAIN cost gate (0 = off; SQLite uses SCAN-op heuristic)
# EXPLAIN_COST_LIMIT=0
# Relationship discovery on schema scan
# RELATIONSHIP_DISCOVERY_ENABLED=true
# RELATIONSHIP_AUTO_APPROVE=true
# Column-level hybrid retrieval when table count exceeds this
# LARGE_SCHEMA_TABLE_THRESHOLD=40
# COLUMN_EXPLORATION_ENABLED=true
# LEARNING_LOOP_ENABLED=true
# PARALLEL_INTENT_RETRIEVAL=false
# (fan-out disabled until AgentState uses Annotated reducers; prefer MERGE_INTERPRET_GENERATE)
DEBUG=false
# First-boot local admin (must change password before using the app)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=AstraSQL-change-me
SESSION_TTL_DAYS=7
