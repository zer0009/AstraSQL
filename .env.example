OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
LLM_PROVIDER=openai
# Required when DEBUG=false. Generate a long random string, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ENCRYPTION_KEY=
SQLITE_URL=sqlite+aiosqlite:///./data/astrasql.db
# Optional alias of SQLITE_URL (use later to point metadata at Postgres)
# DATABASE_URL=
DATA_DIR=./data
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
MAX_RESULT_ROWS=500
MAX_CONVERSATION_TURNS=3
DEBUG=false
# First-boot local admin (must change password before using the app)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=AstraSQL-change-me
SESSION_TTL_DAYS=7
